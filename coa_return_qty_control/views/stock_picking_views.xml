<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_coa_return_summary" model="ir.ui.view">
        <field name="name">stock.picking.form.coa.return.summary</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']"
                   position="after">
                <group string="Return Status"
                       invisible="not x_coa_return_summary">
                    <field name="x_coa_return_summary" nolabel="1" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
